flowchart TD
    A([开始: 获取Pod快照\nUID + ResourceVersion + Annotations]) --> B[并行调度计算\nFilter / Score / Reserve]
    B --> C[构建 BindRequest\n提取 AssumedNode]
    C --> D{Embedded Binder\n是否启用?}

    D -- 否 --> L[Legacy 路径\nPatchPod -> Shared Binder]
    D -- 是 --> E[进入绑定临界区\n调用 Pod Bind API]

    E --> F{Bind 成功?}
    F -- 是 --> G[FinishReserving\n确认提交成功]
    F -- 否 --> H{错误类型}

    H -- 409/Timeout/429 --> I[记录重试指标\n退避后重试]
    I --> J{attempt < MaxBindRetries?}
    J -- 是 --> E
    J -- 否 --> K[标记绑定失败]

    H -- 其他不可重试 --> K

    K --> M[累加失败计数\n记录最后失败原因]
    M --> N[写入失败回退队列\nAPICallFailedTaskQueue]

    N --> O{failureCount >=\nMaxLocalRetries?}
    O -- 否 --> P[本地回退\nPodState=Dispatched\n同 Scheduler 重试]
    O -- 是 --> Q[全局回退\nPodState=Pending\n清理 Scheduler 标记\n回到 Dispatcher]

    G --> R([结束: 输出 BindResult\nSuccess / Partial / Failure])
    P --> R
    Q --> R
    L --> R

    %% color theme
    classDef startEnd fill:#0b132b,color:#ffffff,stroke:#0b132b,stroke-width:2px;
    classDef compute fill:#e0fbfc,color:#102a43,stroke:#3a506b,stroke-width:1.5px;
    classDef decision fill:#ffe8d6,color:#7f2704,stroke:#f4a261,stroke-width:2px;
    classDef critical fill:#ffd6d6,color:#7a0019,stroke:#d62828,stroke-width:2px;
    classDef retry fill:#fff3b0,color:#5f370e,stroke:#e09f3e,stroke-width:1.5px;
    classDef success fill:#d9f99d,color:#14532d,stroke:#65a30d,stroke-width:1.5px;
    classDef fallback fill:#e9d5ff,color:#4a044e,stroke:#9333ea,stroke-width:1.5px;
    classDef legacy fill:#cde7ff,color:#0b3c5d,stroke:#3b82f6,stroke-width:1.5px;

    class A,R startEnd;
    class B,C compute;
    class D,F,H,J,O decision;
    class E,K critical;
    class I,N retry;
    class G success;
    class P,Q fallback;
    class L legacy;
