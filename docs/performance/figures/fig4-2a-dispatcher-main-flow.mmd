    classDef critical fill:#ffd6d6,color:#7a0019,stroke:#d62828,stroke-width:2px;
    classDef errorRef fill:#fff3b0,color:#5f370e,stroke:#e09f3e,stroke-width:1.5px;

    class Leader,U,V startEnd;
    class E,F process;
    class H,N,P decision;
