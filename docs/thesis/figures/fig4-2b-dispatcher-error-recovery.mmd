flowchart TD
    A([来自图 4-2a\nsendPodToScheduler / PatchPod 失败]) --> B[清 DispatchInfo 缓存\n若 SupportRescheduling 启用则同时清 OwnerInfo]

    B --> C{apierrors.IsNotFound?}

    C -- 是 --> D([Pod 已删除\n不重入队\n流程结束]):::ignore
    C -- 否 --> E[originalQueue.AddPodInfo\n直接重新入队 SortedPodsQueue]

    E --> F([回到主排序队列\n由 sortedLoop 下轮再分发])

    classDef startEnd fill:#0b132b,color:#ffffff,stroke:#0b132b,stroke-width:2px;
    classDef decision fill:#ffe8d6,color:#7f2704,stroke:#f4a261,stroke-width:2px;
    classDef action fill:#cde7ff,color:#0b3c5d,stroke:#3b82f6,stroke-width:1.5px;
    classDef ignore fill:#cbd5e1,color:#334155,stroke:#64748b,stroke-width:1.5px;

    class A,F startEnd;
    class C decision;
    class B,E action;
